# ==============================================================================
# CodeLite AI - Environment Configuration
# Bifrost LLM Gateway is the central and mandatory AI communication layer
# ==============================================================================

# Bifrost LLM Gateway Connection
BIFROST_BASE_URL=http://localhost:8080/v1
BIFROST_API_KEY=your_bifrost_key
BIFROST_MODEL=openai/gpt-4o-mini

# CodeLite AI Agent Settings
MAX_REPAIR_ATTEMPTS=5
TOKEN_BUDGET_WARN=3000
CONTEXT_CACHE_ENABLED=true

# Sandbox Settings (Docker container sandbox with secure subprocess fallback)
DOCKER_SANDBOX_ENABLED=true
EXECUTION_TIMEOUT_SECONDS=10
MAX_MEMORY_MB=256

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Demonstration Mode: "auto" (falls back to transparent labeled demo mode if Bifrost is offline),
# "false" (strict mode: errors if Bifrost is unreachable), or "true" (forced demo mode)
DEMO_MODE=auto
